
#strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_OAUTH_STATE_SECRET=

# Layered architecture storage/state
USE_FIRESTORE_STATE=true
FIRESTORE_ATHLETES_COLLECTION=athletes
FIRESTORE_PIPELINE_RUNS_COLLECTION=pipeline_runs
GCS_KNOWLEDGE_BUCKET=adk-kb-bucket
STRAVA_KNOWLEDGE_BUCKET=adk-strava-kb-bucket
 

# Internal trigger protection
INTERNAL_PIPELINE_TOKEN=
INTERNAL_PIPELINE_BASE_URL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=./strava-chat.json

# Pinecone (vector index for wiki RAG)
PINECONE_API_KEY=
PINECONE_INDEX=strava-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
GOOGLE_API_KEY=
AGENT_LLM_MODEL=gemini-2.5-flash
WIKI_LLM_MODEL=gemini-2.5-flash
WIKI_EMBEDDING_MODEL=llama-text-embed-v2
WIKI_EMBEDDING_DIMENSION=768

